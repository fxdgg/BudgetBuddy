{
  "enabledPlugins": {
    "superpowers@codebuddy-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codebuddy/hooks/budget-notify-hook.py && python3 .codebuddy/hooks/budget-notify-hook.py || exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codebuddy/hooks/budget-notify-hook.py && python3 .codebuddy/hooks/budget-notify-hook.py || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codebuddy/hooks/budget-notify-hook.py && python3 .codebuddy/hooks/budget-notify-hook.py || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codebuddy/hooks/budget-notify-hook.py && python3 .codebuddy/hooks/budget-notify-hook.py || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
